diff --git a/core/sources/compiler/src/mcs251/wide_loop_split.c.inc b/core/sources/compiler/src/mcs251/wide_loop_split.c.inc
new file mode 100644
index 0000000..b690b0a
--- /dev/null
+++ b/core/sources/compiler/src/mcs251/wide_loop_split.c.inc
@@ -0,0 +1,183 @@
+/* GPL-2.0-or-later. Split boundary values at a loop's entry and exit.
+ * Values used in the loop receive a fresh allocation; unused live-through
+ * values use a private spill. No C object or memory access moves. */
+extern int mcs251LoopSplitEnabled;
+
+typedef struct {
+  int first,last,entry;
+  wide_bits split,in,out,parked;
+  unsigned count,inputs,outputs,bytes,score;
+} wide_split_region;
+
+static bool
+wide_split_region_find(wide_function *f,int first,int last,wide_split_region *r)
+{
+  if(first<=0 || last+1>=f->nn || f->nj)return false;
+  int entry=-1;bool exits=false;wide_bits used={{0}};
+  for(int i=0;i<f->nn;++i) {
+    wide_node *n=&f->nodes[i];bool inside=i>=first && i<=last;
+    if(inside) {
+      if(n->op==RETURN || n->op==ENDFUNCTION || n->op==RECEIVE || n->op==FUNCTION)return false;
+      used=wb_or(used,wb_or(n->use,n->def));
+    }
+    for(int k=0;k<2;++k) {
+      int s=n->succ[k];if(s<0)continue;
+      bool target=s>=first && s<=last;
+      if(!inside && target) {
+        if(entry>=0 && entry!=s)return false;
+        entry=s;
+      } else if(inside && !target) {
+        if(s!=last+1)return false;
+        exits=true;
+      }
+    }
+  }
+  if(entry<0 || !exits || f->nodes[entry].op!=LABEL)return false;
+  *r=(wide_split_region){.first=first,.last=last,.entry=entry};
+  for(int v=0;v<f->nv;++v) {
+    wide_value *value=&f->values[v];
+    bool in=wb_has(f->nodes[entry].in,v),out=wb_has(f->nodes[last+1].in,v);
+    if(value->loopParked || value->pin>=0 || value->floating || (!in && !out))continue;
+    bool active=wb_has(used,v);
+    if(active ? f->splitRegs[v]>=0 : f->splitRegs[v]<0)continue;
+    wb_set(&r->split,v);++r->count;r->bytes+=value->width;
+    if(in) {wb_set(&r->in,v);++r->inputs;}
+    if(out) {wb_set(&r->out,v);++r->outputs;}
+    if(!wb_has(used,v))wb_set(&r->parked,v);
+  }
+  r->score=r->bytes*(unsigned)(last-first+1);
+  return r->count!=0;
+}
+
+static wide_node
+wide_split_node(unsigned op,iCode *origin)
+{
+  return (wide_node){.op=op,.origin=origin,.left={.value=-1},
+    .right={.value=-1},.addressIndex={.value=-1},.result=-1,
+    .label=-1,.target=-1,.succ={-1,-1},.addressObject=-1};
+}
+
+static wide_node
+wide_split_copy(wide_function *f,int destination,int source,iCode *origin)
+{
+  wide_value *v=&f->values[source];wide_node n=wide_split_node('=',origin);
+  n.result=destination;n.width=v->width;n.sign=v->sign;n.floating=v->floating;
+  n.right=(wide_operand){.value=source,.width=v->width,.sign=v->sign,
+    .floating=v->floating,.codePointer=v->codePointer};
+  wb_set(&n.use,source);wb_set(&n.def,destination);return n;
+}
+
+static unsigned
+wide_split_loop_lifetime(wide_function *f)
+{
+  if(!mcs251LoopSplitEnabled)return 0;
+  wide_split_region best={0};unsigned regions=0;
+  for(int last=1;last+1<f->nn;++last)for(int k=0;k<2;++k) {
+    int first=f->nodes[last].succ[k];wide_split_region r;
+    if(first<0 || first>=last || !wide_split_region_find(f,first,last,&r))continue;
+    ++regions;
+    if(r.score>best.score)best=r;
+  }
+  if(!best.count)return 0;
+  unsigned prefix=best.inputs+1+(best.entry!=best.first),suffix=best.outputs+1;
+  if(f->nv+(int)best.count>f->valueLimit || f->nn+(int)(prefix+suffix)>f->nodeLimit)return 0;
+  int oldCount=f->nn,oldValues=f->nv,map[WN_MAX],clone[WV_MAX];
+  int entryLabel=wt(f),exitLabel=wt(f);
+  for(int i=0;i<oldCount;++i)
+    map[i]=i+(i>=best.first?(int)prefix:0)+(i>best.last?(int)suffix:0);
+  for(int v=0;v<oldValues;++v)if(wb_has(best.split,v)) {
+    int copy=f->nv++;clone[v]=copy;f->values[copy]=f->values[v];
+    f->values[copy].pin=f->values[copy].preference=-1;
+    f->values[copy].loopParked=wb_has(best.parked,v);
+  }
+  wide_node *nodes=Safe_alloc((oldCount+prefix+suffix)*sizeof *nodes);
+  int entry=best.first,exit=map[best.last]+1;
+  iCode *before=f->nodes[best.first-1].origin,*after=f->nodes[best.last+1].origin;
+  int at=entry;
+  nodes[at]=wide_split_node(LABEL,before);nodes[at++].label=entryLabel;
+  for(int v=0;v<oldValues;++v)if(wb_has(best.in,v))
+    nodes[at++]=wide_split_copy(f,clone[v],v,before);
+  if(best.entry!=best.first) {
+    nodes[at]=wide_split_node(GOTO,before);
+    nodes[at].target=f->nodes[best.entry].label;
+    nodes[at++].succ[0]=map[best.entry];
+  }
+  for(int i=entry;i<at;++i)if(nodes[i].op!=GOTO)nodes[i].succ[0]=i+1;
+  at=exit;nodes[at]=wide_split_node(LABEL,after);nodes[at++].label=exitLabel;
+  for(int v=0;v<oldValues;++v)if(wb_has(best.out,v))
+    nodes[at++]=wide_split_copy(f,v,clone[v],after);
+  for(int i=exit;i<at;++i)nodes[i].succ[0]=i+1;
+  for(int i=0;i<oldCount;++i) {
+    nodes[map[i]]=f->nodes[i];wide_node *n=&nodes[map[i]];
+    bool inside=i>=best.first && i<=best.last;
+    if(inside) {
+      wide_bits use={{0}},def={{0}};
+      for(int v=0;v<oldValues;++v) {
+        int mapped=wb_has(best.split,v)?clone[v]:v;
+        if(wb_has(n->use,v))wb_set(&use,mapped);
+        if(wb_has(n->def,v))wb_set(&def,mapped);
+      }
+      n->use=use;n->def=def;
+      int *operands[WA_MAX+3]={&n->left.value,&n->right.value,&n->addressIndex.value,&n->result};
+      for(unsigned k=0;k<n->stackArgs;++k)operands[k+4]=&n->stackOperands[k].value;
+      for(unsigned k=0;k<4+n->stackArgs;++k)
+        if(wb_has(best.split,*operands[k]))*operands[k]=clone[*operands[k]];
+    }
+    for(int k=0;k<2;++k) {
+      int s=n->succ[k];if(s<0)continue;
+      bool explicitEdge=n->op==GOTO || k==1;
+      if(!inside && s==best.entry) {
+        n->succ[k]=entry;if(explicitEdge)n->target=entryLabel;
+      } else if(inside && s==best.last+1) {
+        n->succ[k]=exit;if(explicitEdge)n->target=exitLabel;
+      } else n->succ[k]=map[s];
+    }
+  }
+  f->nn=oldCount+prefix+suffix;
+  memcpy(f->nodes,nodes,f->nn*sizeof *nodes);Safe_free(nodes);
+  wide_reset_allocation(f);
+  dbuf_printf(f->diagnostics,"; wide loop-split region function=%s first=%d last=%d entry=%d candidates=%u values=%u inputs=%u outputs=%u bytes=%u\n",
+    currFunc->name,best.first,best.last,best.entry,regions,best.count,best.inputs,best.outputs,best.bytes);
+  return best.count;
+}
+
+static mcs251_wide_result
+wide_choose_allocation(wide_function *f,wide_selection_cost *cost)
+{
+  if(!mcs251LoopSplitEnabled)return wide_choose_allocation_base(f,cost);
+  struct dbuf_s original,trialCode;
+  dbuf_init(&original,1024);dbuf_init(&trialCode,1024);
+  struct dbuf_s *output=f->candidateOutput;
+  wide_selection_cost old={0},next={0};
+  f->candidateOutput=&original;
+  mcs251_wide_result result=wide_choose_allocation_base(f,&old);
+  f->candidateOutput=output;
+  wide_function *trial=NULL;unsigned changes=0;bool selected=false;int paths=-1;
+  if(result==MCS251_WIDE_ACCEPTED && old.spills && !old.unknown) {
+    trial=Safe_alloc(sizeof *trial);memcpy(trial,f,sizeof *trial);
+    trial->candidateOutput=&trialCode;
+    changes=wide_split_loop_lifetime(trial);
+    if(changes) {
+      wide_liveness(trial);
+      mcs251_wide_result candidate=wide_choose_allocation_base(trial,&next);
+      if(candidate==MCS251_WIDE_ERROR)result=candidate;
+      selected=candidate==MCS251_WIDE_ACCEPTED && !next.unknown &&
+        next.bytes<=old.bytes && next.heuristic<=old.heuristic && next.frame<=old.frame &&
+        (next.bytes<old.bytes || next.heuristic<old.heuristic || next.frame<old.frame);
+      if(selected) {
+        paths=wide_loop_cost_compare_canonical(dbuf_get_buf(&original),dbuf_get_length(&original),
+          dbuf_get_buf(&trialCode),dbuf_get_length(&trialCode),wide_resolve_cost_operand,NULL,f,trial);
+        selected=paths==1;
+      }
+      dbuf_printf(f->diagnostics,"; wide loop-split choice function=%s values=%u selected=%u old-bytes=%u new-bytes=%u old-unknown=%u new-unknown=%u old-weighted=%u new-weighted=%u old-frame=%d new-frame=%d old-spills=%u new-spills=%u paths=%d\n",
+        currFunc->name,changes,selected,old.bytes,next.bytes,old.unknown,next.unknown,
+        old.heuristic,next.heuristic,old.frame,next.frame,old.spills,next.spills,paths);
+    }
+  }
+  if(result==MCS251_WIDE_ACCEPTED) {
+    struct dbuf_s *chosen=selected?&trialCode:&original;
+    dbuf_append(output,dbuf_get_buf(chosen),dbuf_get_length(chosen));
+    if(cost)*cost=selected?next:old;
+  }
+  Safe_free(trial);dbuf_destroy(&original);dbuf_destroy(&trialCode);return result;
+}
