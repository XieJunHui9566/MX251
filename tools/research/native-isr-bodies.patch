+/* Wide locals and spills are above the context, addressed relative to SPX.
+ * A frame needs no adjustment when context pairs are removed, but initially
+ * keep its complete layout. Calls retain their real IR for the common effects
+ * analysis; generated labels are checked against this body's own labels. */
+void mcs251FinishWideIsr(struct dbuf_s *output,ebbIndex *ebbi,int frame)
+{
+  char *text=Safe_strdup(dbuf_c_str(output)),*line=text;
+  lineNode *head=NULL,*tail=NULL;
+  while(*line) {
+    char *end=strchr(line,'\n');if(end)*end=0;
+    lineNode *p=newLineNode(line);
+    if(tail){tail->next=p;p->prev=tail;}else head=p;tail=p;
+    li_line parsed;
+    if(li_parse(p,&parsed) && !strcmp(parsed.op,"ecall") && parsed.nargs==1)
+      for(int b=0;b<ebbi->count;++b) {
+        eBBlock *bb=ebbi->bbOrder[b];
+        for(iCode *ic=bb->sch;ic;ic=ic==bb->ech?NULL:ic->next)
+          if(ic->op==CALL && IS_SYMOP(IC_LEFT(ic)) &&
+             !strcmp(parsed.arg[0],OP_SYMBOL(IC_LEFT(ic))->rname))p->ic=ic;
+      }
+    if(!end)break;line=end+1;
+  }
+  dbuf_set_length(output,0);
+  if(!frame)li_trim_saves(head,0,output);
+  /* Keep the original spelling and column placement of labels/metadata. */
+  for(lineNode *p=head;p;p=p->next)dbuf_printf(output,"%s\n",p->line);
+  while(head){lineNode *next=head->next;Safe_free(head->line);Safe_free(head->aln);Safe_free(head);head=next;}
+  Safe_free(text);
+  /* The bank switch belongs to the context, outside branch relaxation. */
+  const char *all=dbuf_get_buf(output),*begin=strstr(all,"; mx251-isr-body-begin\n");
+  const char *end=strstr(all,"; mx251-isr-body-end\n");
+  if(begin && end && (begin=strchr(begin,'\n')+1)<end) {
+    char *shortened=mb_optimize(begin,(size_t)(end-begin),li_cost_symbol,NULL);
+    if(shortened) {
+      struct dbuf_s result;dbuf_init(&result,dbuf_get_length(output));
+      dbuf_append(&result,all,(size_t)(begin-all));dbuf_append_str(&result,shortened);
+      dbuf_append(&result,end,dbuf_get_length(output)-(size_t)(end-all));
+      dbuf_destroy(output);*output=result;free(shortened);
+    }
+  }
+}
