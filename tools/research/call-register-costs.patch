diff --git a/core/sources/compiler/src/mcs251/wide_register_costs.c.inc b/core/sources/compiler/src/mcs251/wide_register_costs.c.inc
new file mode 100644
index 0000000..b915141
--- /dev/null
+++ b/core/sources/compiler/src/mcs251/wide_register_costs.c.inc
@@ -0,0 +1,61 @@
+/* GPL-2.0-or-later. Explicit research input: caller demand is a placement
+ * preference, never a claim that a callee preserves a register. Actual writes
+ * still flow through the qualified builder's existing clobber feedback. */
+extern char *mcs251RegisterCostsFile;
+typedef struct wide_register_costs {
+  char name[SDCC_NAME_MAX+1];
+  unsigned costs[32];
+  struct wide_register_costs *next;
+} wide_register_costs;
+static wide_register_costs *wideRegisterCosts;
+
+void mcs251LoadRegisterCosts(void)
+{
+  if(!mcs251RegisterCostsFile)return;
+  FILE *file=fopen(mcs251RegisterCostsFile,"rb");
+  char line[SDCC_NAME_MAX+512];unsigned count=0;int status;
+  if(!file)goto invalid;
+  if(wide_effect_line(file,line,sizeof line)!=1 ||
+     strcmp(line,"MX251-REGISTER-COSTS-1"))goto invalid;
+  while((status=wide_effect_line(file,line,sizeof line))==1) {
+    char *name=strtok(line," \t");
+    if(!name || strlen(name)>SDCC_NAME_MAX || ++count>4096)goto invalid;
+    for(char *p=name;*p;++p)
+      if(!isalnum((unsigned char)*p) && *p!='_' && *p!='$' && *p!='.')goto invalid;
+    for(wide_register_costs *p=wideRegisterCosts;p;p=p->next)
+      if(!strcmp(p->name,name))goto invalid;
+    wide_register_costs *entry=Safe_alloc(sizeof *entry);strcpy(entry->name,name);
+    for(unsigned i=0;i<32;++i) {
+      char *value=strtok(NULL," \t"),*end;
+      if(!value || !isdigit((unsigned char)*value))goto invalid;
+      unsigned long n=strtoul(value,&end,10);
+      if(*end || n>1000000)goto invalid;
+      entry->costs[i]=(unsigned)n;
+    }
+    if(strtok(NULL," \t"))goto invalid;
+    entry->next=wideRegisterCosts;wideRegisterCosts=entry;
+  }
+  if(status<0)goto invalid;
+  fclose(file);return;
+invalid:
+  if(file)fclose(file);
+  werror(E_BAD_INT_ARGUMENT,"--mcs251-register-costs: invalid research input");
+  exit(EXIT_FAILURE);
+}
+
+static const unsigned *wide_register_costs_for(symbol *function)
+{
+  /* The prototype accepts unique exported ABI2 definitions. Per-unit static
+   * names need a separate binding format and do not borrow export costs. */
+  if(!function || IS_STATIC(function->etype) || FUNC_SDCCCALL(function->type)!=2)return NULL;
+  for(wide_register_costs *p=wideRegisterCosts;p;p=p->next)
+    if(!strcmp(p->name,function->rname))return p->costs;
+  return NULL;
+}
+
+static unsigned wide_incoming_register_cost(const unsigned *costs,int reg,int width)
+{
+  unsigned cost=0;
+  for(int i=reg;i<reg+width;++i)cost+=costs[i];
+  return cost;
+}
