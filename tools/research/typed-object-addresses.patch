+/* DATA pointer objects occupy three bytes; the leading MIR byte is padding.
+ * Direct objects retain byte transactions, including volatile field accesses. */
+static void
+wmemory_symbol_pointer(wide_function *f,wide_node *n)
+{
+  bool store=n->op==WM_SYMBOL_STORE;
+  int value=store?n->right.value:n->result;
+  int reg=value>=0?f->values[value].reg:-1;
+  we(f,"; wide DATA pointer %s physical=3 logical=4 offset=%d\n",store?"store":"load",n->addressOffset);
+  if(store && n->storedAddress) {
+    we(f,"; wide symbolic pointer store %s%+d\n",n->storedAddress->rname,n->storedAddressOffset);
+    for(int k=0;k<2;++k)
+      we(f,"\tmov\t(%s+%d),#((%s%+d)>>%d)\n",n->addressSymbol->rname,n->addressOffset+k,
+         n->storedAddress->rname,n->storedAddressOffset,8*(2-k));
+    we(f,"\tmov\t(%s+%d),#(%s%+d)\n",n->addressSymbol->rname,n->addressOffset+2,
+       n->storedAddress->rname,n->storedAddressOffset);
+    return;
+  }
+  if(store && n->right.value<0) {
+    for(int k=0;k<3;++k)
+      we(f,"\tmov\t(%s+%d),#0x%02lx\n",n->addressSymbol->rname,n->addressOffset+k,
+         (unsigned long)((n->right.literal>>(8*(2-k)))&255));
+    return;
+  }
+  if(reg>=0 && reg+4<=16) {
+    if(!store)we(f,"\tmov\tr%d,#0\n",reg);
+    for(int k=0;k<3;++k)
+      if(store)we(f,"\tmov\t(%s+%d),r%d\n",n->addressSymbol->rname,n->addressOffset+k,reg+1+k);
+      else we(f,"\tmov\tr%d,(%s+%d)\n",reg+1+k,n->addressSymbol->rname,n->addressOffset+k);
+    return;
+  }
+  if(store)wload(f,n->right,20,4);
+  for(int k=0;k<3;++k) {
+    if(store) {
+      if(k<2)we(f,"\tmov\twr10,wr%d\n",k?22:20);
+      we(f,"\tmov\t(%s+%d),%s\n",n->addressSymbol->rname,n->addressOffset+k,k==1?"b":"a");
+    } else {
+      we(f,"\tmov\ta,(%s+%d)\n",n->addressSymbol->rname,n->addressOffset+k);
+      if(!k)we(f,"\tmovz\twr20,a\n");
+      else if(k==1)we(f,"\tmov\tb,a\n");
+      else we(f,"\tmov\twr22,wr10\n");
+    }
+  }
+  if(!store)wstore_known(f,n->result,20,true);
+}
