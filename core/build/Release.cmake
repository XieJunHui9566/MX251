# Public CMake/StudioX entry: use the same defaults as Build-Core.ps1.
include_guard(GLOBAL)
set(MX251_FUNCTION_GC ON CACHE BOOL "Remove unreachable functions")
set(MX251_FUNCTION_SHARING ON CACHE BOOL "Share identical function templates")
set(MX251_MACHINE_IR ON CACHE BOOL "Use the shared machine pipeline")
set(MX251_CALLEE_PRESERVATION ON CACHE BOOL "Select callee-preserved registers")
set(MX251_WIDE_VALUE_LIMIT 1024 CACHE STRING "Wide values")
set(MX251_WIDE_NODE_LIMIT 2048 CACHE STRING "Wide nodes")
file(READ "${CMAKE_SOURCE_DIR}/mx251.json" _mx_release_config)
string(JSON _mx_runtime GET "${_mx_release_config}" runtime)
string(JSON _mx_model GET "${_mx_release_config}" model)
string(JSON _mx_backend GET "${_mx_release_config}" backend)
string(JSON _mx_explicit GET "${_mx_release_config}" explicitAbi)
set(_mx_native OFF)
if(_mx_runtime STREQUAL "standard" AND _mx_model STREQUAL "small"
   AND _mx_backend STREQUAL "ordinary-wide" AND NOT _mx_explicit)
  set(_mx_native ON)
endif()
if(NOT DEFINED MX251_NATIVE_INTEGER_RUNTIME)
  set(MX251_NATIVE_INTEGER_RUNTIME "${_mx_native}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/qualified/Project.cmake")
