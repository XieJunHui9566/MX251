# CMake 管理源码和头文件路径；芯片 ABI/内存选项由工程详情保存。
include_guard(GLOBAL)
option(MX251_C251_BIT_COMPLEMENT "Explicit C251 bit/sbit complement dialect; not ISO _Bool" OFF)
set(MX251_CALLEE_COST_FILE "" CACHE FILEPATH "Exact linked callee cost evidence")
set(MX251_CALLEE_COST_SHA256 "" CACHE STRING "Pinned callee cost evidence SHA-256")
option(MX251_RANGE_NARROW_MULTIPLY "Use point-range proven u32 by u16 low products" OFF)
option(MX251_CONSTANT_ROTATE_FUSION "Experimental known-cost unsigned32 constant rotate fusion" OFF)
option(MX251_VOLATILE_DATA_WIDE "Explicit ordinary DATA volatile object width; not an atomic guarantee" OFF)
option(MX251_WORD_COMPARE_IMMEDIATE "Use exact 16-bit immediate comparisons" OFF)
option(MX251_LEAF_CALL_FEEDBACK "Experimental bound two-pass leaf register effects" OFF)
option(MX251_FUNCTION_GC "Conservative whole-firmware function reachability" OFF)
set(MX251_ORDERED_ASM "AUTO" CACHE STRING "Use declared target ordered-assembly capability (AUTO or OFF)")
set_property(CACHE MX251_ORDERED_ASM PROPERTY STRINGS AUTO OFF)
set(MX251_WIDE_VALUE_LIMIT "128" CACHE STRING "Bounded wide backend value capacity")
set(MX251_WIDE_NODE_LIMIT "512" CACHE STRING "Bounded wide backend node capacity")
set_property(CACHE MX251_WIDE_VALUE_LIMIT PROPERTY STRINGS 128 256 512)
set_property(CACHE MX251_WIDE_NODE_LIMIT PROPERTY STRINGS 512 1024 2048)
if(NOT MX251_WIDE_VALUE_LIMIT MATCHES "^(128|256|512)$" OR NOT MX251_WIDE_NODE_LIMIT MATCHES "^(512|1024|2048)$")
  message(FATAL_ERROR "Unsupported bounded wide backend capacity")
endif()
if(NOT MX251_ORDERED_ASM STREQUAL "AUTO" AND NOT MX251_ORDERED_ASM STREQUAL "OFF")
  message(FATAL_ERROR "MX251_ORDERED_ASM must be AUTO or OFF")
endif()
set(MX251_FUNCTION_GC_KEEP "" CACHE STRING "Additional externally reachable assembly symbols (semicolon separated)")
function(mx251_json_string output value)
  if("${value}" MATCHES "\\$<|[\n\r]")
    message(FATAL_ERROR "MX251: generator expressions/newlines are not supported here: ${value}")
  endif()
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
function(mx251_json_array output)
  set(result "[]")
  set(index 0)
  foreach(value IN LISTS ARGN)
    mx251_json_string(quoted "${value}")
    string(JSON result SET "${result}" ${index} "${quoted}")
    math(EXPR index "${index}+1")
  endforeach()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
function(mx251_firmware target)
  # 工程可在配置阶段按 runtime 选择宏；JSON 变更必须触发 CMake 重新配置。
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/mx251.json")
  if(NOT DEFINED MX251_BUILD_SCRIPT OR NOT DEFINED MX251_PWSH OR NOT DEFINED MX251_PROFILE OR NOT DEFINED MX251_TOOLCHAIN)
    message(FATAL_ERROR "Set MX251_BUILD_SCRIPT, MX251_PWSH, MX251_PROFILE and MX251_TOOLCHAIN to explicit tool paths; see STANDALONE.md.")
  endif()
  get_target_property(kind ${target} TYPE)
  if(NOT kind STREQUAL "INTERFACE_LIBRARY")
    message(FATAL_ERROR "MX251 requires an INTERFACE library describing the firmware inputs")
  endif()
  foreach(unsupported IN ITEMS INTERFACE_LINK_LIBRARIES INTERFACE_COMPILE_OPTIONS INTERFACE_LINK_OPTIONS)
    get_target_property(value ${target} ${unsupported})
    if(value)
      message(FATAL_ERROR "MX251: unsupported ${unsupported}; do not silently discard build options")
    endif()
  endforeach()
  get_target_property(sources ${target} INTERFACE_SOURCES)
  get_target_property(includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
  get_target_property(defines ${target} INTERFACE_COMPILE_DEFINITIONS)
  if(NOT sources)
    message(FATAL_ERROR "MX251: no sources registered with target_sources")
  endif()
  if(NOT includes)
    set(includes "")
  endif()
  if(NOT defines)
    set(defines "")
  endif()
  set(units "[]")
  set(index 0)
  foreach(source IN LISTS sources)
    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    mx251_json_string(quoted "${source}")
    string(JSON unit SET "{}" file "${quoted}")
    foreach(unsupported IN ITEMS COMPILE_OPTIONS COMPILE_FLAGS INCLUDE_DIRECTORIES)
      get_source_file_property(value "${source}" ${unsupported})
      if(value AND NOT value STREQUAL "NOTFOUND")
        message(FATAL_ERROR "MX251: unsupported source ${unsupported}: ${source}")
      endif()
    endforeach()
    get_source_file_property(source_defines "${source}" COMPILE_DEFINITIONS)
    if(source_defines AND NOT source_defines STREQUAL "NOTFOUND")
      mx251_json_array(source_define_json ${source_defines})
      string(JSON unit SET "${unit}" defines "${source_define_json}")
    endif()
    # 显式存储策略只改变现有编译选项；非重入安全性仍需完整调用图证明。
    get_source_file_property(stack_auto "${source}" MX251_STACK_AUTO)
    if(NOT stack_auto STREQUAL "NOTFOUND")
      if(NOT stack_auto STREQUAL "ON" AND NOT stack_auto STREQUAL "OFF")
        message(FATAL_ERROR "MX251_STACK_AUTO must be ON or OFF")
      endif()
      if(stack_auto STREQUAL "ON")
        string(JSON unit SET "${unit}" stackAuto true)
      else()
        string(JSON unit SET "${unit}" stackAuto false)
      endif()
    endif()
    foreach(property IN ITEMS MX251_BACKEND MX251_ARCHIVE)
      get_source_file_property(value "${source}" ${property})
      if(value AND NOT value STREQUAL "NOTFOUND")
        mx251_json_string(quoted "${value}")
        string(JSON unit SET "${unit}" ${property} "${quoted}")
      endif()
    endforeach()
    string(JSON units SET "${units}" ${index} "${unit}")
    math(EXPR index "${index}+1")
  endforeach()
  mx251_json_array(include_json ${includes})
  mx251_json_array(define_json ${defines})
  file(WRITE "${CMAKE_BINARY_DIR}/mx251-inputs.json" "{\"sources\":${units},\"includeDirectories\":${include_json},\"defines\":${define_json}}\n")
  set(feedback_arguments "")
  if(MX251_C251_BIT_COMPLEMENT)
    list(APPEND feedback_arguments -C251BitComplement)
  endif()
  if(MX251_CALLEE_COST_FILE)
    list(APPEND feedback_arguments -CalleeCostFile "${MX251_CALLEE_COST_FILE}" -CalleeCostSha256 "${MX251_CALLEE_COST_SHA256}")
  endif()
  if(MX251_RANGE_NARROW_MULTIPLY)
    list(APPEND feedback_arguments -RangeNarrowMultiply)
  endif()
  if(MX251_CONSTANT_ROTATE_FUSION)
    list(APPEND feedback_arguments -ConstantRotateFusion)
  endif()
  if(MX251_VOLATILE_DATA_WIDE)
    list(APPEND feedback_arguments -VolatileDataWide)
  endif()
  if(MX251_WORD_COMPARE_IMMEDIATE)
    list(APPEND feedback_arguments -WordCompareImmediate)
  endif()
  if(MX251_LEAF_CALL_FEEDBACK)
    list(APPEND feedback_arguments -LeafCallFeedback)
  endif()
  if(MX251_FUNCTION_GC)
    list(APPEND feedback_arguments -FunctionGc)
    if(MX251_FUNCTION_GC_KEEP)
      string(REPLACE ";" "," gc_keep "${MX251_FUNCTION_GC_KEEP}")
      list(APPEND feedback_arguments -FunctionGcKeep "${gc_keep}")
    endif()
  endif()
  add_custom_target(firmware ALL
    COMMAND "${MX251_PWSH}" -NoLogo -NoProfile -NonInteractive -File "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BuildLatest.ps1"
      -BuildScript "${MX251_BUILD_SCRIPT}"
      -Project "${CMAKE_SOURCE_DIR}/mx251.json" -ToolchainRoot "${MX251_TOOLCHAIN}"
      -ProfileRoot "${MX251_PROFILE}" -OutputDirectory "${CMAKE_SOURCE_DIR}/.build/mx251/latest"
      -CMakeInput "${CMAKE_BINARY_DIR}/mx251-inputs.json"
      -OrderedAsm "${MX251_ORDERED_ASM}"
      -WideValueLimit "${MX251_WIDE_VALUE_LIMIT}" -WideNodeLimit "${MX251_WIDE_NODE_LIMIT}"
      ${feedback_arguments}
    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" VERBATIM USES_TERMINAL)
endfunction()
