/* Binary32 fixed decimal, precision 0..9, round to nearest/even.
 * Decimal digits represent mantissa * 10^precision exactly; binary scaling
 * retains the final discarded bit and sticky bits. No floating arithmetic,
 * long-long helpers, static storage, or magnitude-dependent overflow.
 * 39 integer digits + 9 fractional digits cover every finite binary32. */
static unsigned char mx_float(uint32_t raw, unsigned char precision,
    unsigned char width, unsigned char flags)
{
    unsigned char digits[48];
    unsigned char n, i, bit, carry, sticky=0, c, total, pad;
    unsigned char negative=(unsigned char)(raw>>31);
    unsigned char exponent=(unsigned char)(raw>>23);
    int shift;
    raw &= 0x7fffffUL;
    if(exponent==255u) {
        digits[2]=raw?'n':'i'; digits[1]=raw?'a':'n'; digits[0]=raw?'n':'f';
        if(flags&2u) for(i=0;i<3u;++i) digits[i]-='a'-'A';
        n=3; precision=0; flags&=(unsigned char)~4u;
    } else {
        for(i=0;i<48u;++i) digits[i]=0;
        shift=exponent?(int)exponent-150:-149;
        if(exponent) raw|=0x800000UL;
        n=precision+1u;
        bit=24;
        do {
            carry=(raw&0x800000UL)?1u:0u; raw<<=1;
            for(i=precision;i<n;++i) {
                c=(unsigned char)(digits[i]*2u+carry);
                carry=c>=10u; digits[i]=carry?(unsigned char)(c-10u):c;
            }
            if(carry) digits[n++]=carry;
        } while(--bit);
        while(shift>0) {
            carry=0;
            for(i=0;i<n;++i) {
                c=(unsigned char)(digits[i]*2u+carry);
                carry=c>=10u; digits[i]=carry?(unsigned char)(c-10u):c;
            }
            if(carry) digits[n++]=carry;
            --shift;
        }
        carry=0;
        while(shift<0) {
            sticky|=carry; carry=0; i=n;
            do {
                --i; c=(unsigned char)(digits[i]+(carry?10u:0u));
                digits[i]=c>>1; carry=c&1u;
            } while(i);
            if(n>1u && !digits[n-1u]) --n;
            ++shift;
        }
        if(carry && (sticky || (digits[0]&1u))) {
            i=0;
            while(i<n && digits[i]==9u) digits[i++]=0;
            if(i==n) digits[n++]=1; else ++digits[i];
        }
        while(n<=precision) digits[n++]=0;
        for(i=0;i<n;++i) digits[i]+='0';
    }
    total=(unsigned char)(n+negative+(precision?1u:0u));
    pad=width>total?(unsigned char)(width-total):0;
    total=(unsigned char)(total+pad);
    if(!(flags&4u)) while(pad) { putchar(' '); --pad; }
    if(negative) putchar('-');
    if(flags&4u) while(pad) { putchar('0'); --pad; }
    do {
        putchar(digits[--n]);
        if(precision && n==precision) putchar('.');
    } while(n);
    return total;
}
